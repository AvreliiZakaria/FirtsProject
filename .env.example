# Copy this file to .env.local and fill in your real values.

# --- AITUNEL (image generation) ---
# Get your key at https://aitunnel.ru/ (Personal Cabinet → API keys).
AITUNEL_API_KEY=sk-aitunnel-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional overrides (defaults are shown below).
# AITUNEL_BASE_URL=https://api.aitunnel.ru/v1
# AITUNEL_MODEL=flux.2-flex

# --- Supabase (Auth + Postgres) ---
# Project Settings → API → Project URL / anon public key / service_role key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only — bypasses RLS. NEVER expose to the client / NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin access — comma-separated emails that can use /admin.
# Log in with one of these to manage trends & categories.
ADMIN_EMAILS=you@example.com
